<Window x:Class="Feeder.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Feeder monitor simulation" Height="750" Width="1050" MinHeight="600" MinWidth="800">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock FontSize="24" FontWeight="Bold" Text="Feeder monitor"/><TextBlock Text="Simulated readings only. Not connected to equipment."/><TextBlock AutomationProperties.AutomationId="Status" Text="{Binding Status}" Margin="0,8"/></StackPanel>
    <TextBlock Grid.Row="1" Text="Current trend (A), most recent 120 readings" FontWeight="Bold" Margin="0,5"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Monitor.Readings}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="Readings"><DataGrid.Columns><DataGridTextColumn Header="Time (UTC)" Binding="{Binding RecordedAtUtc}"/><DataGridTextColumn Header="Feeder" Binding="{Binding Feeder}"/><DataGridTextColumn Header="Voltage (V)" Binding="{Binding Voltage}"/><DataGridTextColumn Header="Current (A)" Binding="{Binding Current}"/><DataGridCheckBoxColumn Header="Breaker closed" Binding="{Binding BreakerClosed}"/></DataGrid.Columns></DataGrid><Viewbox Grid.Column="1" Stretch="Fill" Margin="12,0"><Canvas Width="480" Height="180" Background="#F0F4F7"><Polyline Stroke="#1A6091" StrokeThickness="2" Points="{Binding Trend}"/></Canvas></Viewbox></Grid>
    <DockPanel Grid.Row="3" Margin="0,12,0,5"><Button DockPanel.Dock="Right" Content="Acknowledge selected" Command="{Binding Monitor.AcknowledgeCommand}" AutomationProperties.AutomationId="Acknowledge"/><TextBlock Text="Threshold alarms" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
    <DataGrid Grid.Row="4" ItemsSource="{Binding Monitor.Alarms}" SelectedItem="{Binding Monitor.SelectedAlarm}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Time (UTC)" Binding="{Binding RecordedAtUtc}"/><DataGridTextColumn Header="Alarm" Binding="{Binding Message}"/><DataGridCheckBoxColumn Header="Acknowledged" Binding="{Binding Acknowledged}"/></DataGrid.Columns></DataGrid>
  </Grid>
</Window>
